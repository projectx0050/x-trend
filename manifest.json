{
  "manifest_version": 3,
  "name": "X-Trend",
  "version": "1.4.0",
  "description": "Your AI writing workspace, always open beside your browser. Captions, rewrites, hashtags, review replies, emails and proposals.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open X-Trend",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://x-trend-backend.onrender.com/*"
  ]
}
